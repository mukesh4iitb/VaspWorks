create_XDATCAR_using_CONTCARs() {
for dir in "$@";
do
elem_num=$(sed -n '7p' "$dir/CONTCAR")
line_num=$(echo $elem_num 8 | tr ' ' '+' | bc)
head -n "$line_num" "$dir/CONTCAR" >> XDATCAR.vasp
done
}

