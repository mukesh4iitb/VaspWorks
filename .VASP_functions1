scf_convergence_combined() {
    # Read input: either from args or stdin
    if [[ -t 0 && "$#" -ne 0 ]]; then
      input=("$@")
    else
      # Read from stdin into array
      mapfile -t input
    fi

    local sn=1

    echo -e "System\t\t\tSCF Status"
    echo "-------------------------------"

    for folder in "${input[@]}"; do
    new_folder="${folder/OUTCAR}"
            if [ ! -f $new_folder/INCAR ] || [ ! -f $new_folder/OSZICAR ]; then
                echo -e "$new_folder\t\t\e[1;31mMissing INCAR or OSZICAR\e[0m"
                continue
            fi

            nelm_incar_line=$(grep -E '^[^#]*\bNELM\b' $new_folder/INCAR)
            if [[ -z "$nelm_incar_line" ]]; then
                nelm_in=60
            else
                nelm_in=$(echo "$nelm_incar_line" | awk -F '=' '{print $2}' | awk '{print $1}' | tr -d ' ')
            fi

            nelm_os=$(grep -w -B 1 "1 F=" $new_folder/OSZICAR | head -n 1 | awk '{print $2}')

            if [[ -z "$nelm_os" ]]; then
                echo -e "$new_folder\t\t\e[1;31mNot completed SCF\e[0m"
            else
                if [[ $nelm_in -gt $nelm_os ]]; then
                    echo -e "$new_folder\t\t\e[32mConverged\e[0m"
                else
                    echo -e "$new_folder\t\t\e[31mNot converged\e[0m"
                fi
            fi
   
    done
}

